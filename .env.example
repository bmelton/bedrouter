# Copy to .env (gitignored). Values already in the environment win over this file.
# Credentials: any one source from the AWS SDK default chain.
#   Home (Identity Center):  AWS_PROFILE=bedrouter        then `aws sso login --profile bedrouter`
#   Work (corporate SSO):    AWS_PROFILE=BAHSSO_xxxxxx_ADMIN  then `aws sso login --profile BAHSSO_xxxxxx_ADMIN`
#   Keys:                    AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= (/ AWS_SESSION_TOKEN=)
#   Bedrock API key:         AWS_BEARER_TOKEN_BEDROCK=
AWS_PROFILE=bedrouter
AWS_REGION=us-east-1
# BEDROUTER_DEBUG=1        # print every request/decision/result to stdout (or: npm run start:debug)
# PORT=20129
# BEDROUTER_CONFIG=./bedrouter.json
# BEDROUTER_LOG=./bedrouter.log.jsonl
# BEDROUTER_API_KEY=
